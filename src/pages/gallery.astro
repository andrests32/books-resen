---
import Layout from '@/Layout/Layout.astro'
import { getCollection } from 'astro:content'
import { GalleryBooks } from '@/components/Gallery'

const books = (await getCollection('books')).map((b) => b.data)
---

<Layout title="Galería de libros | BooksResen">
	<GalleryBooks books={books} client:visible />
</Layout>
