---
import '../styles/global.css'
import '../styles/starwind.css'
import { ClientRouter } from 'astro:transitions'
import Navbar from '@/components/Navbar.astro'

interface Props {
	title: string
}

const { title } = Astro.props
---

<html lang="en" class="custom-scroll">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

		<!-- Precarga de funtes -->
		<link rel="preload" href="/fonts/broela.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/poppis.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/legend-sacred.woff2" as="font" type="font/woff2" crossorigin />

		<script is:inline>
			function applyTheme() {
				const isDark =
					localStorage.theme === 'dark' ||
					(!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)

				document.documentElement.classList.toggle('dark', isDark)
			}

			applyTheme()

			document.addEventListener('astro:page-load', applyTheme)
		</script>

		<ClientRouter />
		<title>{title}</title>
	</head>
	<body>
		<main>
			<Navbar />
			<slot />
		</main>
	</body>
</html>

<style>
	html {
		text-rendering: optimizeLegibility;
		-webkit-font-smoothing: antialiased;
		scroll-behavior: smooth;
	}
	/* Scroll global */
	html {
		scrollbar-width: thin;
	}

	/* Light mode */
	html:not(.dark) {
		scrollbar-color: rgba(0, 0, 0, 0.25) transparent;
	}

	/* Dark mode */
	html.dark {
		scrollbar-color: rgba(134, 51, 70, 0.5) transparent;
	}

	/* Chrome, Edge, Safari */
	html::-webkit-scrollbar {
		width: 6px;
	}

	html::-webkit-scrollbar-track {
		background: transparent;
	}

	/* Light */
	html:not(.dark)::-webkit-scrollbar-thumb {
		background-color: rgba(0, 0, 0, 0.25);
		border-radius: 9999px;
	}

	html:not(.dark)::-webkit-scrollbar-thumb:hover {
		background-color: rgba(0, 0, 0, 0.4);
	}

	/* Dark */
	html.dark::-webkit-scrollbar-thumb {
		background-color: rgba(134, 51, 70, 0.5);
		border-radius: 9999px;
	}

	html.dark::-webkit-scrollbar-thumb:hover {
		background-color: rgba(134, 51, 70, 0.8);
	}
</style>
