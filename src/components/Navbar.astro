---
import ButtonTheme from './Button-Theme.astro'
import Title from './Title.astro'
import Search from './Search.astro'

interface Props {
	class?: string
}

const { class: className = '' } = Astro.props
---

<nav
	id="main-nav"
	class={`sticky top-0 z-70 flex flex-5 w-full justify-between lg:pt-20 bg-surface/90 
	 dark:bg-[#0a0a0a]/90 backdrop-blur-md
	${className}`}
>
	<h1 class="flex flex-col items-start justify-start lg:px-20">
		<Title
			id="main-title"
			class="font-primary text-primary-100 dark:text-surface text-3xl font-semibold antialiased transition-all duration-300 lg:text-7xl"
		>
			Books-Resen
		</Title>

		<p
			id="main-subtitle"
			class="font-text text-text-muted dark:text-primary-100 transition-all duration-300 lg:text-3xl"
		>
			reseñas de libros en español
		</p>
	</h1>

	<div class="relative flex items-end justify-center gap-40">
		<ul class="flex gap-12">
			<li>
				<a
					href="/"
					class="font-text text-text-muted dark:text-surface/70 hover:text-primary-400 text-2xl transition-colors duration-300"
				>
					Inicio
				</a>
			</li>
			<li>
				<a
					href="#resenas"
					class="font-text text-text-muted dark:text-surface/70 hover:text-primary-400 text-2xl transition-colors duration-300"
				>
					Reseñas
				</a>
			</li>
			<li>
				<a
					href="#categories"
					class="font-text text-text-muted dark:text-surface/70 hover:text-primary-400 text-2xl transition-colors duration-300"
				>
					Categorías
				</a>
			</li>
			<li>
				<a
					href="/gallery"
					class="font-text text-text-muted dark:text-surface/70 hover:text-primary-400 text-2xl transition-colors duration-300"
				>
					Galería
				</a>
			</li>
		</ul>

		<Search />
	</div>

	<ButtonTheme class="mr-8 flex h-full items-start justify-start" />
</nav>

<script>
	function initNavbar() {
		const nav = document.getElementById('main-nav') as HTMLElement
		const title = document.getElementById('main-title') as HTMLElement
		const subtitle = document.getElementById('main-subtitle') as HTMLElement

		let ticking = false

		function updateNavbar() {
			const scrolled = window.scrollY > 5

			if (scrolled) {
				nav.classList.add('nav-compact')
				title.classList.add('title-compact')
				subtitle.classList.add('subtitle-hide')
			} else {
				nav.classList.remove('nav-compact')
				title.classList.remove('title-compact')
				subtitle.classList.remove('subtitle-hide')
			}

			ticking = false
		}

		window.addEventListener('scroll', () => {
			if (!ticking) {
				requestAnimationFrame(updateNavbar)
				ticking = true
			}
		})
	}

	initNavbar()
	document.addEventListener('astro:page-load', initNavbar)
</script>

<style>
	#main-title {
		transition:
			font-size 300ms ease,
			opacity 300ms ease;
	}

	#main-subtitle {
		transition:
			opacity 200ms ease,
			transform 200ms ease;
	}

	#main-nav {
		transition: padding 300ms ease;
	}

	.nav-compact {
		padding-top: 1rem !important;
		padding-bottom: 1rem !important;
	}

	.title-compact {
		font-size: 2rem !important;
	}

	.subtitle-hide {
		opacity: 0;
		transform: translateY(-4px);
	}
</style>
