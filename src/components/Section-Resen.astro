---
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import Title from './Title.astro'
import { getCollection } from 'astro:content'

const resenasCollection = await getCollection('books')
const resenas = resenasCollection.map((item) => item.data)
---

<section class="mx-auto max-w-400 px-4 lg:py-35">
	<Title class="font-text text-primary-100 dark:text-surface font-semibold lg:py-10 lg:text-5xl"
		>Reseñas literarias destacadas</Title
	>

	<div
		class="custom-scroll mt-10 grid gap-10 overflow-x-hidden overflow-y-auto px-6 lg:max-h-180 lg:grid-cols-2"
	>
		{
			resenas.map((resena) => (
				<div class="review-item group flex transition-all duration-300 ease-out select-none">
					<article class="bg-muted-bg dark:bg-black-soft group-hover:border-primary-100 z-50 flex flex-col items-start justify-evenly gap-4 rounded-lg border-l-4 border-transparent p-6 text-left transition-all duration-300">
						<h3 class="font-text text-gray-5 dark:text-dk-text text-3xl">{resena.title}</h3>

						<p class="font-text text-gray-5 dark:text-dk-text text-base">{resena.description}</p>

						<div class="group relative flex items-center gap-4">
							<a
								data-astro-prefetch="hover"
								href={`/resenas/${resena.slug}`}
								class="text-primary-100 font-text mt-4 inline-block text-xl font-semibold tracking-wide"
							>
								Ver reseña
							</a>

							<Icon
								name="row"
								class="text-primary-100 absolute -bottom-1 left-30 h-8 w-8 rotate-270 transition-all duration-300 group-hover:translate-x-3"
							/>
						</div>
					</article>

					<Image
						transition:name={`image-fade-${resena.slug}`}
						src={resena.image}
						width={800}
						height={800}
						loading="lazy"
						decoding="async"
						quality="high"
						alt={resena.title}
						class="transition-grayscale relative -left-60 z-10 ml-6 h-auto w-48 rounded-lg object-cover opacity-0 grayscale-50 transition-all duration-700 group-hover:left-0 group-hover:opacity-100 group-hover:grayscale-0 dark:grayscale-70 group-hover:dark:grayscale-0"
					/>
				</div>
			))
		}
	</div>
</section>

<style>
	/* .custom-scroll {
		scrollbar-width: thin;
		scrollbar-color: rgba(134, 51, 70, 0.5) transparent;
	}

	.custom-scroll::-webkit-scrollbar {
		width: 6px;
	}

	.custom-scroll::-webkit-scrollbar-track {
		background: transparent;
	}

	.custom-scroll::-webkit-scrollbar-thumb {
		background-color: rgba(134, 51, 70, 0.4);
		border-radius: 9999px;
		transition: background-color 0.3s ease;
	}

	.custom-scroll::-webkit-scrollbar-thumb:hover {
		background-color: rgba(134, 51, 70, 0.7);
	} */

	/* Ocultar scrollbar pero mantener scroll funcional */
	.custom-scroll {
		overflow-y: auto;

		/* Firefox */
		scrollbar-width: none;

		/* IE y Edge antiguos */
		-ms-overflow-style: none;
	}

	/* Chrome, Safari y Edge modernos */
	.custom-scroll::-webkit-scrollbar {
		display: none;
	}
</style>

