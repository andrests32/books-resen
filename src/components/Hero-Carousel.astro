---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import Title from './Title.astro'

import { Card, CardContent } from '@/components/starwind/card'
import {
	Carousel,
	CarouselContent,
	CarouselItem,
	CarouselNext,
	CarouselPrevious
} from '@/components/starwind/carousel'

const heroCollection = await getCollection('books')
const heroBooks = heroCollection.map((item) => item.data).slice(0, 4)
---

<h1 class="flex flex-col items-start justify-start lg:px-20 lg:pt-10 lg:pb-20">
	<Title
		class="font-primary text-primary-100 dark:text-surface text-3xl font-semibold antialiased lg:text-[5rem]"
	>
		Books-Resen
	</Title>

	<p class="font-text text-text-muted dark:text-primary-100 lg:text-4xl">
		reseñas de libros en español
	</p>
</h1>

<Carousel
	id="carousel-autoplay"
	autoInit={false}
	opts={{
		align: 'start',
		loop: true
	}}
	class="bg-muted-bg dark:bg-black-soft mx-auto flex max-w-400 items-center justify-end rounded-3xl select-none"
>
	<CarouselPrevious />

	<CarouselContent class="flex border-none lg:h-160" aria-label="Libros destacados">
		{
			heroBooks.map((book) => (
				<CarouselItem class="h-full basis-full">
					<Card class="h-full bg-transparent shadow-none">
						<CardContent class="grid h-full grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:px-10">
							{/* TEXTO */}
							<div class="flex flex-col justify-center space-y-6">
								<h3 class="font-text text-gray-5 dark:text-dk-text lg:pb-15 lg:pl-8 lg:text-5xl">
									{book.title}
								</h3>

								<blockquote class="relative max-w-2xl lg:pl-8">
									<Icon
										name="quotes-left"
										size={40}
										class="text-primary-100/30 dark:text-primary-400/40 absolute -top-4 -left-2"
									/>

									<p class="font-text text-primary-100 dark:text-dk-text-muted text-lg leading-relaxed italic lg:text-5xl">
										Frase inspiradora del libro
									</p>

									<Icon
										name="quotes-right"
										size={40}
										class="text-primary-100/30 dark:text-primary-400/40 absolute -right-4 -bottom-2"
									/>
								</blockquote>

								<p class="font-text dark:text-dk-text-muted max-w-xl text-lg font-thin lowercase italic lg:pl-8 lg:text-2xl">
									{book.bookfrase}
								</p>
							</div>

							{/* IMAGEN */}
							<div class="flex justify-center lg:justify-end">
								<Image
									src={book.image}
									alt={book.title}
									width={800}
									height={1200}
									class="h-[50vh] w-auto rounded-xl object-cover"
									priority
								/>
							</div>
						</CardContent>
					</Card>
				</CarouselItem>
			))
		}
	</CarouselContent>

	<CarouselNext />
</Carousel>
<script>
	import Autoplay from 'embla-carousel-autoplay'
	import { initCarousel } from '@/components/starwind/carousel'

	function initAutoplayCarousel() {
		const carouselElement = document.getElementById('carousel-autoplay')
		if (!carouselElement) return

		initCarousel(carouselElement, {
			plugins: [
				Autoplay({
					delay: 6000,
					stopOnInteraction: false
				})
			]
		})
	}

	initAutoplayCarousel()
	document.addEventListener('astro:after-swap', initAutoplayCarousel)
</script>
