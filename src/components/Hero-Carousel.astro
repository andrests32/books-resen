---
import type { Book } from '@/interfaces/books-types'
import { client } from '@/lib/client'
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import Title from './Title.astro'

import { Card, CardContent } from '@/components/starwind/card'
import {
	Carousel,
	CarouselContent,
	CarouselItem,
	CarouselNext,
	CarouselPrevious
} from '@/components/starwind/carousel'

const respose = await client.getEntries({
	content_type: 'books'
})

const books: Book[] = respose.items.map((item: any) => ({
	title: item.fields.title,
	slug: item.fields.slug,
	description: item.fields.description,
	body: item.fields.body, // luego puedes transformarlo
	image: `https:${item.fields.imagen.fields.file.url}`
}))
---

<h1 class="flex flex-col items-start justify-start lg:px-20 lg:pt-10 lg:pb-20">
	<Title
		class="font-primary text-primary-100 dark:text-surface text-3xl font-semibold antialiased lg:text-[5rem]"
	>
		Books-Resen
	</Title>
	<p class="font-text text-text-muted dark:text-primary-100 lg:text-4xl">
		reseñas de libros en español
	</p>
</h1>

<Carousel
	id="carousel-autoplay"
	autoInit={true}
	opts={{ align: 'start' }}
	class="mx-auto flex max-w-420 items-center justify-end select-none"
>
	<CarouselPrevious />

	<CarouselContent class="h-160">
		{
			books.map((book) => (
				<CarouselItem class="h-full">
					<Card class="bg-muted-bg dark:bg-black-soft h-full rounded-4xl border-none shadow-none">
						<CardContent class="bg-muted-bg dark:bg-black-soft grid h-full grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:px-10">
							{/* TEXTO */}
							<div class="flex flex-col justify-center space-y-6">
								<h3 class="font-text text-gray-5 dark:text-dk-text lg:pb-15 lg:pl-8 lg:text-5xl">
									{book.title}
								</h3>

								<blockquote class="relative max-w-2xl lg:pl-8">
									<Icon
										name="quotes-left"
										size={40}
										class="text-primary-100/30 dark:text-primary-400/40 absolute -top-4 -left-2"
									/>

									<p class="font-text text-primary-100 dark:text-dk-text-muted text-lg leading-relaxed italic lg:text-5xl">
										Frase inspiradora del libro
									</p>

									<Icon
										name="quotes-right"
										size={40}
										class="text-primary-100/30 dark:text-primary-400/40 absolute -right-4 -bottom-2"
									/>
								</blockquote>

								<p class="font-text dark:text-dk-text-muted max-w-xl text-lg font-thin lowercase italic lg:pl-8 lg:text-2xl">
									{book.description}
								</p>

								{/* <div class="bg-surface dark:bg-primary-100 flex w-max items-center justify-start gap-4 rounded-full px-6 py-2">
									<a
										href={`/books/${book.slug}`}
										class="font-text text-text dark:text-surface text-xl"
									>
										Ver más
									</a>

									<div class="text-primary-100 dark:text-surface">
										<Icon name="row-left" size={30} class="ml-2 inline-block" />
									</div>
								</div> */}
							</div>

							{/* IMAGEN */}
							<div class="flex justify-center lg:justify-end">
								<Image
									src={book.image}
									alt={book.title}
									width={800}
									height={1200}
									class="h-[50vh] w-auto rounded-xl object-cover"
									priority
								/>
							</div>
						</CardContent>
					</Card>
				</CarouselItem>
			))
		}
	</CarouselContent>

	<CarouselNext />
</Carousel>

<script>
	import Autoplay from 'embla-carousel-autoplay'

	import { initCarousel } from '@/components/starwind/carousel'

	function initAutoplayCarousel() {
		const carouselElement = document.getElementById('carousel-autoplay')
		if (!carouselElement) return
		initCarousel(carouselElement, {
			plugins: [
				Autoplay({
					delay: 6000
				})
			]
		})
	}

	initAutoplayCarousel()

	document.addEventListener('astro:after-swap', initAutoplayCarousel)
</script>
