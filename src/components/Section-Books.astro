---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import Title from './Title.astro'

import { Card, CardContent } from '@/components/starwind/card'
import { Carousel, CarouselContent, CarouselItem } from '@/components/starwind/carousel'

const recomended = await getCollection('recomendedBooks')

const section = recomended[0]?.data

if (!section) {
	throw new Error('No se encontró la sección recomendedBooks')
}
---

<section class="lg:py-30">
	<div class="mx-auto w-full max-w-7xl">
		{/* HEADER */}
		<div class="mb-16 space-y-3">
			<span
				class="font-text text-text-muted dark:text-text-light text-xl tracking-[0.25em] uppercase"
			>
				Selección curada
			</span>

			<Title class="font-text text-primary-100 dark:text-surface text-3xl lg:text-5xl">
				{section.sectionTitle}
			</Title>
		</div>

		{/* CAROUSEL */}
		<Carousel
			id="recommended-carousel"
			autoInit={false}
			opts={{
				align: 'start',
				loop: true,
				dragFree: true
			}}
			class="w-full"
		>
			<CarouselContent class="flex gap-8 lg:px-6" aria-label="Libros recomendados">
				{
					section.books.map((book: { image: string }) => (
						<CarouselItem class="basis-2/3 border-none sm:basis-1/2 md:basis-1/3 lg:basis-1/4">
							<Card>
								<CardContent>
									<Image
										src={book.image}
										alt="Libro recomendado"
										width={1200}
										height={800}
										loading="lazy"
										class="h-100 w-full rounded-lg object-contain py-6"
									/>
								</CardContent>
							</Card>
						</CarouselItem>
					))
				}
			</CarouselContent>
		</Carousel>
	</div>
</section>

<script>
	import Autoplay from 'embla-carousel-autoplay'
	import { initCarousel } from '@/components/starwind/carousel'

	function initAutoplayCarousel() {
		const carouselElement = document.getElementById('recommended-carousel')
		if (!carouselElement) return

		initCarousel(carouselElement, {
			plugins: [
				Autoplay({
					delay: 2000,
					stopOnInteraction: false
				})
			]
		})
	}

	initAutoplayCarousel()
	document.addEventListener('astro:after-swap', initAutoplayCarousel)
</script>
